(
    clave:"bandido_venta_zarabad",
    activacion:PorPuntos(puntos:["partida.disponible"]),
    prioridad:10,
    condicion:r#"return mundo:actor_jugador()=="principe_perdido" and mundo:booleana("aperturaBandido",false) and mundo:en_grupo("bandido") and mundo:ubicacion_actor("principe_perdido")=="zarabad" and mundo:colectivo_de("principe_perdido")==nil"#,
    inicio:"advertencia",
    pasos:[
        Vigneta(clave:"advertencia",presentacion:r#"return {titulo="Ante las puertas de Zahrim",momentos={ui.narrar("Rashak se adelanta hacia las puertas del palacio. Nadin te retiene un instante, antes de que lo sigas."),ui.decir("sirviente","No confío en él, señor. Sería mejor irnos y dejarlo aquí."),ui.narrar("Nadin mira hacia la entrada. No tiene pruebas contra Rashak: solo una sospecha. Del otro lado de las puertas, Zahrim puede recibirte.")}}"#,opciones:[(clave:"audiencia",texto:"Seguir a Rashak hasta el rey",siguiente:"venta"),(clave:"rechazar",texto:"Rechazar la audiencia y alejarte",siguiente:"separarse")]),
        Efectos(clave:"venta",salidas:["audiencia"],resolver:r#"return {operaciones={op.separar_companero("bandido","zarabad"), op.esclavizar("principe_perdido","zahrim"), op.esclavizar("sirviente","zahrim"), op.ingresar_grupo_en_colectivo("compania_dahran"), op.establecer_entera("inicioServicioDahran",ctx:ahora().dia_absoluto), op.establecer_booleana("vendidoEnZarabad",true)},siguiente="audiencia"}"#),
        Vigneta(clave:"audiencia",presentacion:r#"return {titulo="Al servicio de Zahrim",momentos={ui.narrar("Rashak recibe una bolsa de manos del tesorero. Zahrim te invita a acercarte antes de que puedas preguntar por la paga."),ui.decir("zahrim","Rashak me ha ofrecido sus servicios. Tendrán alimento, alojamiento y equipo. A cambio servirán en mis barcos, bajo las órdenes del capitán Dahran."),ui.decir("principe_perdido","Veníamos a pedir ayuda. Rashak no nos dijo que ya había cerrado un trato por nosotros."),ui.decir("zahrim","Eso tendrán que hablarlo con él. Yo ya he pagado. Cumplan su servicio y tendrán lugar en esta casa; si saben conducir hombres, no les faltarán responsabilidades."),ui.decir("sirviente","No es lo que habíamos acordado, señor."),ui.narrar("Zahrim llama a un encargado para que les dé comida y un lugar donde descansar. La oferta tiene sus ventajas, pero el trato se hizo sin ustedes: ahora servirán a Zarabad en su disputa con Nuris por el comercio del Mar del Viento.")}}"#,siguiente:Some("fin")),
        Efectos(clave:"separarse",salidas:["rechazo"],resolver:r#"return {operaciones={op.separar_companero("bandido","zarabad"), op.establecer_booleana("rechazoAudienciaZarabad",true)},siguiente="rechazo"}"#),
        Vigneta(clave:"rechazo",presentacion:r#"return {titulo="Por tu cuenta",texto="Te alejás de las puertas con tu sirviente. Rashak insiste una vez, luego deja de seguirlos. La ciudad continúa abierta ante vos, aunque la ayuda que prometía tu guía tenga ahora otro significado."}"#,siguiente:Some("fin")),
        Fin(clave:"fin",control:Continuar),
    ],
)
