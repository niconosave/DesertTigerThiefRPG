(
    clave:"bandido_venta_zarabad",
    activacion:PorPuntos(puntos:["partida.disponible"]),
    prioridad:10,
    condicion:r#"return mundo:actor_jugador()=="principe_perdido" and mundo:booleana("aperturaBandido",false) and mundo:en_grupo("bandido") and mundo:ubicacion_actor("principe_perdido")=="zarabad" and mundo:colectivo_de("principe_perdido")==nil"#,
    inicio:"advertencia",
    pasos:[
        Vigneta(clave:"advertencia",presentacion:r#"return {titulo="El precio de una audiencia",texto="Al llegar a Zarabad, oís a Rashak hablar con un hombre del puerto: «Dos hombres sanos. El precio de siempre». Cuando notan tu presencia, callan. Rashak vuelve sonriendo: el rey Zahrim puede recibirte. Tu sirviente permanece junto a vos, mirando las puertas del recinto."}"#,opciones:[(clave:"audiencia",texto:"Seguir a Rashak hasta el rey",siguiente:"venta"),(clave:"rechazar",texto:"Rechazar la audiencia y alejarte",siguiente:"separarse")]),
        Efectos(clave:"venta",salidas:["audiencia"],resolver:r#"return {operaciones={op.separar_companero("bandido","zarabad"), op.esclavizar("principe_perdido","zahrim"), op.esclavizar("sirviente","zahrim"), op.ingresar_grupo_en_colectivo("compania_dahran"), op.establecer_entera("inicioServicioDahran",ctx:ahora().dia_absoluto), op.establecer_booleana("vendidoEnZarabad",true)},siguiente="audiencia"}"#),
        Vigneta(clave:"audiencia",presentacion:r#"return {titulo="El trato de Rashak",texto="Ante Zahrim, Rashak cobra por ustedes antes de que puedas terminar de explicar quién sos. El rey escucha tu protesta sin devolver la paga: para él, el trato ya está hecho. Vos y tu sirviente servirán en sus barcos bajo las órdenes de Dahran. Zarabad disputa con Nuris el comercio del Mar del Viento; de pronto, esa guerra ajena decide adónde pueden ir."}"#,siguiente:Some("fin")),
        Efectos(clave:"separarse",salidas:["rechazo"],resolver:r#"return {operaciones={op.separar_companero("bandido","zarabad"), op.establecer_booleana("rechazoAudienciaZarabad",true)},siguiente="rechazo"}"#),
        Vigneta(clave:"rechazo",presentacion:r#"return {titulo="Por tu cuenta",texto="Te alejás de las puertas con tu sirviente. Rashak insiste una vez, luego deja de seguirlos. La ciudad continúa abierta ante vos, aunque la ayuda que prometía tu guía tenga ahora otro significado."}"#,siguiente:Some("fin")),
        Fin(clave:"fin",control:Continuar),
    ],
)
