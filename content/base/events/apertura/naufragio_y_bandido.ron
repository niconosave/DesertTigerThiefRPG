(
    clave:"naufragio_y_bandido",
    activacion:EnFecha(fecha:(anio:2025,mes:1,dia:31)),
    observacion:Local(lugar:"costa_ambar"),
    prioridad:0,
    condicion:r#"return mundo:actor_jugador()=="principe_perdido""#,
    inicio:"orilla",
    pasos:[
        Vigneta(clave:"orilla",presentacion:r#"return {titulo="Los restos del naufragio",texto="Despertás en Costa Ámbar entre maderos rotos y jirones de vela. Nadin, tu sirviente, ha logrado sacarte del agua; del barco que debía alejarte de los hombres de tu tío apenas quedan restos. Un hombre con cabeza de tigre baja hasta la orilla y examina lo que el mar ha devuelto."}"#,siguiente:Some("unirse")),
        Efectos(clave:"unirse",salidas:["propuesta"],resolver:r#"return {operaciones={op.incorporar_companero("bandido"), op.establecer_booleana("aperturaBandido",true)},siguiente="propuesta"}"#),
        Vigneta(clave:"propuesta",presentacion:r#"return {titulo="Una ayuda en la costa",texto="El desconocido se presenta como Rashak y se ofrece a acompañarlos. «Zarabad está al norte. Su rey necesita hombres para sus barcos, y yo sé cómo llegar hasta él. Un príncipe sin fortuna todavía puede encontrar quien lo ayude». Tu sirviente recoge lo poco que conservan; Rashak ya señala el camino."}"#,siguiente:Some("fin")),
        Fin(clave:"fin",control:Continuar),
    ],
)
